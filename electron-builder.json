{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.prisma",
  "appId": "com.arcade.layoutstudio",
  "productName": "Arcade Layout Studio",
  "copyright": "Copyright © 2026 Arcade Layout Studio",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*"
  ],
  "mac": {
    "category": "public.app-category.graphics-design",
    "target": [
      {
        "target": "dir",
        "arch": ["arm64"]
      },
      {
        "target": "dmg",
        "arch": ["arm64"]
      }
    ],
    "identity": null,
    "hardenedRuntime": false,
    "gatekeeperAssess": false
  },
  "dmg": {
    "title": "Arcade Layout Studio Installer",
    "contents": [
      {
        "x": 130,
        "y": 220
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ]
  }
}

